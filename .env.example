# LLM provider: openai (default) or cohere. Only the chosen provider's key
# needs to be set.
LLM_PROVIDER=openai

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Cohere API Configuration, used when LLM_PROVIDER=cohere
# COHERE_API_KEY=your_cohere_api_key_here
# COHERE_MODEL=command-a-03-2025

# Database Configuration
#
# Defaults to the SQLite file below when unset. Production sets this to a
# managed Postgres connection string; render.yaml wires it from the database
# instance it declares.
#
# Schema is managed by Alembic, not created at startup. After changing this,
# or on a fresh checkout, run:
#
#     alembic upgrade head
#
DATABASE_URL=sqlite:///./firstplay.db

# Application Settings
#
# Log level for the stdout handler: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
